{
  "name": "openhra-website-tools",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.10",
  "scripts": {
    "format": "prettier --ignore-path .prettierignore --write . && python3 -m ruff format .",
    "format:check": "prettier --ignore-path .prettierignore --check . && python3 -m ruff format --check .",
    "lint": "eslint . --max-warnings 0 && python3 -m ruff check .",
    "check:lint-setup": "node scripts/lint-setup-selftest.mjs",
    "format:inventory": "node scripts/format-inventory.mjs",
    "check:format-budgets": "node scripts/format-budgets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
